# ============================================================================
# 复制成 .env 再填值（.env 不要提交到 git）
# ============================================================================
#   copy .env.example .env      (Windows cmd)
#   Copy-Item .env.example .env (PowerShell)
#
# ⚠️ 只有带「必填」标记的两个是真正要你填的，其余保持默认即可。
# ============================================================================

# ---------- 必填 ----------

# 数据库密码（MySQL root）
#   去哪找：backend/src/main/resources/application.yml 里 datasource.password 的默认值
DB_PASSWORD=在这里填你的MySQL密码

# 百炼 API Key（AI 服务调用大模型用）
#   去哪找：PyCharm 运行配置的环境变量，或 .idea/workspace.xml 里的 DASHSCOPE_API_KEY
DASHSCOPE_API_KEY=sk-在这里填

# ---------- 数据库（默认连宿主机，数据只有一份）----------
# 本地保持 host.docker.internal；云端改成 mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=token_erp_demo
DB_USERNAME=root

# ---------- 鉴权 ----------
# ⚠️ 必须和 backend 用同一个值（AI 服务自己验 JWT，两边密钥差一个字符就全部 401）
#   去哪找：application.yml 里的 jwt.secret
JWT_SECRET=在这里填和application.yml一致的密钥
AI_AUTH_ENABLED=1

# ---------- 语料目录（宿主机绝对路径）----------
CORPUS_DIR_HOST=D:/zhishiku

# ---------- 端口（宿主）----------
# 8090 避开 5173（本机 vite dev）和 5174（另一个项目）
FRONTEND_PORT=8090
BACKEND_PORT=8080
# ⚠️ 起容器前要先停掉宿主原生 redis，否则 6379 冲突
REDIS_PUBLISH_PORT=6379
